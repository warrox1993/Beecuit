{
  "name": "au-fil-des-saveurs",
  "version": "0.1.0",
  "private": true,
  "//browserslist": "Modern targets only — drops Next.js legacy polyfills (Array.at, Object.hasOwn, etc.) that recent browsers don't need. Safe for a 2026 launch.",
  "browserslist": [
    "last 2 years",
    "not dead",
    "not op_mini all"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "seed": "dotenv -e .env.local -- tsx scripts/seed/index.ts"
  },
  "dependencies": {
